# Copy to .dev.vars for local development. .dev.vars is gitignored and must
# never be committed. Use Razorpay TEST keys here, never live ones.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
PASS_SIGNING_KEY_V1=
SESSION_SECRET=
DOC_ENCRYPTION_KEY=

# Email. Leave MAIL_PROVIDER unset locally and every message is written to the
# console, which is enough to read a verification code out of the log.
# MAIL_PROVIDER=zeptomail
# ZEPTOMAIL_TOKEN=
# ZEPTOMAIL_REGION=in
